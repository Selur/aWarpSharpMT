#include <winver.h>
#include "version.hpp"

VS_VERSION_INFO VERSIONINFO
FILEVERSION AWARP_VERSION_MAJOR, AWARP_VERSION_MINOR, AWARP_VERSION_PATCH, 0
PRODUCTVERSION AWARP_VERSION_MAJOR, AWARP_VERSION_MINOR, AWARP_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Selur"
      VALUE "FileDescription", "aWarpSharpMT: warp sharpening (aWarpSharp2, aSobel, aBlur, aWarp) for AviSynth+ and VapourSynth"
      VALUE "FileVersion", AWARP_VERSION
      VALUE "InternalName", "aWarpSharpMT"
      VALUE "LegalCopyright", "(c) 2003 MarcFD, 2012 Skakov Pavel, 2015 Firesledge, 2016 pinterf, JPSDR, 2026 Selur, GPL v2+"
      VALUE "OriginalFilename", "aWarpSharpMT.dll"
      VALUE "ProductName", "aWarpSharpMT"
      VALUE "ProductVersion", AWARP_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
